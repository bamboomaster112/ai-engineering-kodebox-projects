# AI Desk reads ~/.env on the KodeBox (the image's own file) and then this folder's .env.
# Never commit a real .env. KodeKey keys go in ~/.env as the KodeBox login message explains.
OPENAI_BASE_URL=https://api.ai.kodekloud.com/v1
OPENAI_API_KEY=

# kodekey (default when OPENAI_API_KEY is set) or fake (offline, no tokens)
# AIDESK_PROVIDER=fake

# Token caps that stop a run before it spends too much of your KodeKey allowance
# AIDESK_RUN_TOKEN_CAP=40000
# AIDESK_DAILY_TOKEN_CAP=150000

# Response cache (1 = reuse identical calls, which makes re-runs free)
# AIDESK_CACHE=1

# Web search backend for Ask-the-Web and Deep Research: ddgs (default, no key), tavily, fixture
# AIDESK_SEARCH=ddgs
# TAVILY_API_KEY=

# Role overrides
# AIDESK_MODEL_FAST=
# AIDESK_MODEL_MAIN=
# AIDESK_MODEL_REASONING=
